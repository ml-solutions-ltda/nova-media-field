{
    "name": "mlsolutions/nova-media-field",
    "version": "2.0.0",
    "homepage": "https://github.com/ml-solutions-ltda/nova-media-field",
    "description": "Laravel Nova media fields and host-authorized thumbnail previews.",
    "keywords": [
        "laravel",
        "nova",
        "media",
        "field"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/nova": "^4.22 || ^5.0"
    },
    "suggest": {
        "spatie/laravel-medialibrary": "Required only when using the Media field.",
        "stepanenko3/nova-filemanager": "Optional File Manager integration. Install a release compatible with your Laravel Nova version."
    },
    "autoload": {
        "psr-4": {
            "Mlsolutions\\NovaMediaField\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mlsolutions\\NovaMediaField\\FieldServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://laravelsatis.com"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "tightenco/duster": "^3.0"
    }
}
